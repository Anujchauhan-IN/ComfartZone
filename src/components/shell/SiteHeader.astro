  <div class="mx-auto flex h-14 max-w-[var(--content-shell)] items-center justify-between px-4 md:h-15 md:px-6">
    <a class="inline-flex items-center gap-2 rounded-input font-extrabold tracking-[-0.02em]" href="/" aria-label="ComfartZone home">
      <MascotMark />
      <span class="text-lg">ComfartZone</span>
    </a>
    <span class="hidden text-xs font-bold text-ink-muted sm:block">Anonymous opinions. Consequences may vary.</span>
  </div>
</header>
