---
import { POST_TYPE_OPTIONS } from '../../lib/feed';
import NavIcon from './NavIcon.astro';
const icons = { all: 'home', confession: 'confession', petty_court: 'court', am_i_weird: 'weird', hot_take: 'takes' } as const;
---
<aside class="desktop-sidebar hidden lg:block" aria-label="Primary navigation">
  <nav class="sticky top-5">
    <p class="eyebrow px-3">Browse the mess</p>
    <div class="mt-2 space-y-1">
      {POST_TYPE_OPTIONS.map((item) => (
        <a class="sidebar-link" data-feed-type={item.value} href={item.value === 'all' ? '/' : '/?type=' + item.value}>
          <NavIcon name={icons[item.value]} /><span>{item.label}</span>
        </a>
      ))}
    </div>
    <div class="sidebar-divider"></div>
    <p class="eyebrow px-3">Quick topics</p>
    <div class="mt-2 space-y-1 text-sm">
      <a class="sidebar-topic" href="/?topic=relationships">Relationships</a>
      <a class="sidebar-topic" href="/?topic=work">Work</a>
      <a class="sidebar-topic" href="/?topic=social-awkwardness">Social awkwardness</a>
      <a class="sidebar-topic" href="/?topic=everyday-life">Everyday life</a>
    </div>
    <section class="sidebar-note"><strong>No names. No follower counts.</strong><span>Just stories and opinions that could have stayed private.</span></section>
  </nav>
</aside>
