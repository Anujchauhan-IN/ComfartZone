---
import NavIcon from './NavIcon.astro';
---
<nav class="mobile-bottom-nav lg:hidden" aria-label="Primary navigation">
  <a class="mobile-nav-link" data-mobile-nav="home" href="/">
    <NavIcon name="home" /><span>Home</span>
  </a>
  <a class="mobile-nav-link" data-mobile-nav="explore" href="/?sort=popular">
    <NavIcon name="explore" /><span>Explore</span>
  </a>
  <button class="mobile-nav-link mobile-nav-link--post" data-open-composer type="button">
    <span class="mobile-nav-post-icon"><NavIcon name="post" /></span><span>Post</span>
  </button>
  <a class="mobile-nav-link" data-mobile-nav="court" data-feed-type="petty_court" href="/?type=petty_court">
    <NavIcon name="court" /><span>Court</span>
  </a>
  <a class="mobile-nav-link" data-mobile-nav="takes" data-feed-type="hot_take" href="/?type=hot_take">
    <NavIcon name="takes" /><span>Takes</span>
  </a>
</nav>
