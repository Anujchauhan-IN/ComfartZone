---
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_NAME } from '../lib/constants';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_NAME, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff9f2" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script>
      const feedTypes = new Set(['all', 'regular', 'confession', 'petty_court', 'am_i_weird', 'hot_take']);
      const syncFeedNavigation = () => {
        const onFeed = window.location.pathname === '/';
        const params = new URLSearchParams(window.location.search);
        const requested = params.get('type') ?? 'all';
        const activeType = onFeed && feedTypes.has(requested) ? requested : '';
        const mobileDestination = !onFeed
          ? ''
          : activeType === 'petty_court'
            ? 'court'
            : activeType === 'hot_take'
              ? 'takes'
              : params.get('sort') === 'popular'
                ? 'explore'
                : 'home';
        document.querySelectorAll<HTMLElement>('[data-feed-type]').forEach((link) => {
          const active = link.dataset.feedType === activeType;
          link.classList.toggle('sidebar-link--active', active && link.classList.contains('sidebar-link'));
          if (active && link.classList.contains('sidebar-link')) link.setAttribute('aria-current', 'page');
          else if (link.classList.contains('sidebar-link')) link.removeAttribute('aria-current');
        });
        document.querySelectorAll<HTMLElement>('[data-mobile-nav]').forEach((link) => {
          const active = link.dataset.mobileNav === mobileDestination;
          link.classList.toggle('mobile-nav-link--active', active);
          if (active) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
      };
      syncFeedNavigation();
      window.addEventListener('popstate', syncFeedNavigation);
      window.addEventListener('cz:querychange', syncFeedNavigation);
      document.addEventListener('click', (event) => {
        const element = event.target instanceof Element ? event.target : null;
        const composerButton = element?.closest<HTMLElement>('[data-open-composer]');
        if (composerButton) {
          event.preventDefault();
          if (window.location.pathname === '/') window.dispatchEvent(new CustomEvent('cz:open-composer', { detail: { trigger: composerButton } }));
          else window.location.href = '/?compose=1';
          return;
        }
        const target = element?.closest<HTMLAnchorElement>('[data-feed-type], [data-mobile-nav="home"], [data-mobile-nav="explore"]');
        if (!target || window.location.pathname !== '/' || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        window.history.pushState({}, '', target.href);
        window.dispatchEvent(new Event('cz:querychange'));
      });
    </script>
  </body>
</html>
